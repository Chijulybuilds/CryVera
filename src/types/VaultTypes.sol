pragma solidity ^0.8.24;

/*//////////////////////////////////////////////////////////////
                         VAULT TYPES
//////////////////////////////////////////////////////////////*/

/// @title VeriBridge Vault Types
/// @notice Shared vault data structures.
library VaultTypes {
    /*//////////////////////////////////////////////////////////////
                          USER POSITION
    //////////////////////////////////////////////////////////////*/
    struct VaultPosition {
        uint256 shares;
        uint256 strategyId;
    }

    /*//////////////////////////////////////////////////////////////
                        DEPOSIT REQUEST
    //////////////////////////////////////////////////////////////*/
    struct DepositParams {
        address asset;
        uint256 assets;
        address receiver;
        uint256 strategyId;
    }

    /*//////////////////////////////////////////////////////////////
                        REDEMPTION REQUEST
    //////////////////////////////////////////////////////////////*/
    struct RedeemParams {
        uint256 shares;
        address receiver;
    }

    /*//////////////////////////////////////////////////////////////
                        GLOBAL ACCOUNTING
    //////////////////////////////////////////////////////////////*/
    struct VaultState {
        uint256 totalAssets;
        uint256 totalShares;
    }
}
